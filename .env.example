# LeadScout Frontend Environment Variables

# URL of your deployed FastAPI backend (e.g. https://your-backend.up.railway.app)
# When set, browser fetches and WebSockets connect directly to this backend URL:
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app

# Optional server-side backend URL used by Next.js rewrites to proxy /api/*
BACKEND_URL=https://your-backend.up.railway.app

# LeadScout Backend Environment Variables

# Application
APP_NAME=LeadScout
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Database (PostgreSQL)
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql+asyncpg://leadscout:leadscout@localhost:5432/leadscout

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WORKER_CONCURRENCY=4

# API & CORS
API_PREFIX=/api
# Comma-separated or JSON list of allowed frontend origins:
CORS_ORIGINS=["https://web-scraping-production.up.railway.app","http://localhost:3000"]
ALLOWED_HOSTS=*

# Security & JWT (Generate a random 32+ character key!)
JWT_SECRET_KEY=change-this-to-a-super-secret-random-key-with-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# Discovery
DISCOVERY_ENABLE_FIXTURES=false
PUBLIC_SEARCH_TIMEOUT_SECONDS=12.0
PUBLIC_SEARCH_MAX_RETRIES=2

# Crawler
PLAYWRIGHT_ENABLED=false
HTTP_TIMEOUT_SECONDS=15.0
CRAWLER_USER_AGENT=LeadScoutBot/1.0 (+https://leadscout.app/bot)
